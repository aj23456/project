    "### 1.2 Loss function design (10 pts)\n",
    "\n",
    "The objective is\n",
    "\n",
    "    L = w_mse * MSE + w_ssim * (1 - SSIM) + w_grad * L1(Sobel gradients)\n",
    "\n",
    "with weights 1.0, 0.6 and 0.3. MSE alone minimises pointwise error, and the cheapest way to do\n",
    "that on a stochastic texture such as a dune field is to output the local mean, so a pure-MSE\n",
    "autoencoder produces smooth reconstructions and a large residual on every dune in the archive.\n",
    "That inflates the reconstruction error of ordinary terrain and buries the genuine outliers.\n",
    "\n",
    "SSIM is computed on an 11x11 Gaussian window and compares local means, variances and\n",
    "covariance, so it rewards reproducing the local contrast structure rather than the local mean.\n",
    "The Sobel term adds a direct penalty on mismatched edges, which is what keeps crater rims and\n",
    "ridgelines sharp.\n",
    "\n",
    "Both terms are written here from scratch and use only the images themselves. No pretrained\n",
    "network is involved, so this does not fall under the banned perceptual-loss rule."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def _gauss_win(ws=11, sigma=1.5):\n",
    "    c = torch.arange(ws, dtype=torch.float32) - ws // 2\n",
    "    g = torch.exp(-(c ** 2) / (2 * sigma ** 2)); g = g / g.sum()\n",
    "    w = torch.outer(g, g)\n",
    "    return w[None, None]\n",
    "\n",
    "\n",
    "class SSIM(nn.Module):\n",
    "    \"\"\"Differentiable single-channel SSIM for inputs in [0, 1].\"\"\"\n",
    "    def __init__(self, ws=11, sigma=1.5):\n",
    "        super().__init__()\n",
    "        self.register_buffer(\"w\", _gauss_win(ws, sigma))\n",
    "        self.pad = ws // 2\n",
    "\n",
    "    def forward(self, x, y):\n",
    "        w = self.w.to(x.dtype)\n",
    "        mx = F.conv2d(x, w, padding=self.pad)\n",
    "        my = F.conv2d(y, w, padding=self.pad)\n",
    "        mxx, myy, mxy = mx * mx, my * my, mx * my\n",
    "        sx = F.conv2d(x * x, w, padding=self.pad) - mxx\n",
    "        sy = F.conv2d(y * y, w, padding=self.pad) - myy\n",
    "        sxy = F.conv2d(x * y, w, padding=self.pad) - mxy\n",
    "        C1, C2 = 0.01 ** 2, 0.03 ** 2\n",
    "        s = ((2 * mxy + C1) * (2 * sxy + C2)) / ((mxx + myy + C1) * (sx + sy + C2))\n",
    "        return s.mean()\n",
    "\n",
    "\n",
    "_KX = torch.tensor([[1., 0., -1.], [2., 0., -2.], [1., 0., -1.]])[None, None] / 4.0\n",
    "_KY = _KX.transpose(-1, -2).contiguous()\n",
    "\n",
    "\n",
    "def image_grads(x):\n",
    "    kx, ky = _KX.to(x.device, x.dtype), _KY.to(x.device, x.dtype)\n",
    "    return F.conv2d(x, kx, padding=1), F.conv2d(x, ky, padding=1)\n",
    "\n",
    "\n",
    "ssim_fn = SSIM().to(DEV)\n",
    "\n",
    "\n",
    "def composite_loss(x, xh, mu=None, logvar=None, beta=0.0):\n",
    "    mse = F.mse_loss(xh, x)\n",
    "    dssim = 1.0 - ssim_fn(xh, x)\n",
    "    gx, gy = image_grads(x); hx, hy = image_grads(xh)\n",
    "    grad = F.l1_loss(hx, gx) + F.l1_loss(hy, gy)\n",
    "    total = CFG[\"w_mse\"] * mse + CFG[\"w_ssim\"] * dssim + CFG[\"w_grad\"] * grad\n",
    "    parts = {\"mse\": mse.item(), \"dssim\": dssim.item(), \"grad\": grad.item()}\n",
    "    if beta > 0 and mu is not None and logvar is not None:\n",
    "        kl = (-0.5 * (1 + logvar - mu.pow(2) - logvar.exp()).sum(1)).mean()\n",
    "        total = total + beta * kl\n",
    "        parts[\"kl\"] = kl.item()\n",
    "    return total, parts"
   ]
