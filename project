   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from scipy.stats import spearmanr, kruskal, binomtest\n",
    "\n",
    "meta = pd.read_csv(CFG[\"metadata_csv\"]).drop_duplicates(\"source_image_id\")\n",
    "df = index_df.merge(meta, on=\"source_image_id\", how=\"left\")\n",
    "assert len(df) == len(index_df), \"metadata join changed the row count; check for duplicate IDs\"\n",
    "df = df.reset_index(drop=True)          # row order must stay aligned with Z and X\n",
    "print(\"crops without metadata:\", int(df[\"latitude\"].isna().sum()))\n",
    "\n",
    "sub = df.dropna(subset=[\"sun_angle\"])\n",
    "rho, p_rho = spearmanr(sub[\"sun_angle\"], sub[\"novelty\"])\n",
    "print(f\"Spearman(novelty, sun_angle) = {rho:.3f}  (p = {p_rho:.3g})\")\n",
    "\n",
    "if \"resolution\" in df.columns:\n",
    "    r2, p2 = spearmanr(sub[\"resolution\"], sub[\"novelty\"])\n",
    "    print(f\"Spearman(novelty, resolution) = {r2:.3f}  (p = {p2:.3g})\")\n",
    "\n",
    "groups = [g[\"novelty\"].values for _, g in df.dropna(subset=[\"season\"]).groupby(\"season\")]\n",
