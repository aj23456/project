   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from scipy.stats import gaussian_kde\n",
    "from scipy.optimize import minimize\n",
    "\n",
    "\n",
    "def mad_threshold(s, k=3.5):\n",
    "    med = np.median(s)\n",
    "    return float(med + k * np.median(np.abs(s - med)) * 1.4826)\n",
    "\n",
    "\n",
    "def kde_valley_threshold(s, grid=2048):\n",
    "    kde = gaussian_kde(s)\n",
    "    xs = np.linspace(s.min(), s.max(), grid); d = kde(xs)\n",
    "    i0 = int(np.argmax(d))\n",
    "    for i in range(i0 + 1, grid - 1):\n",
    "        if d[i] < d[i - 1] and d[i] <= d[i + 1]:\n",
    "            return float(xs[i]), xs, d\n",
    "    return None, xs, d\n",
    "\n",
    "\n",
    "def kneedle_threshold(s):\n",
    "    \"\"\"Elbow = sorted point of maximum vertical distance below the endpoint chord.\"\"\"\n",
    "    v = np.sort(s); n = len(v)\n",
    "    x = np.arange(n) / (n - 1)\n",
    "    y = (v - v[0]) / (v[-1] - v[0] + 1e-12)\n",
    "    i = int(np.argmax(x - y))\n",
    "    return float(v[i]), x, y, i\n",
    "\n",
    "\n",
    "def gpd_censored_fit(ex, c):\n",
    "    \"\"\"GPD MLE on exceedances ex > 0, with observations above c right-censored.\"\"\"\n",
    "    y = ex[ex <= c]; k = int((ex > c).sum())\n",
    "\n",
    "    def nll(p):\n",
    "        xi, ls = p; s = float(np.exp(ls))\n",
    "        if abs(xi) < 1e-6:\n",
    "            ll = (-np.log(s) - y / s).sum() - k * (c / s)\n",
    "        else:\n",
    "            z = 1 + xi * y / s; zc = 1 + xi * c / s\n",
    "            if np.any(z <= 0) or zc <= 0:\n",
    "                return 1e12\n",
    "            ll = (-np.log(s) - (1 + 1 / xi) * np.log(z)).sum() - k * np.log(zc) / xi\n",
    "        return -ll\n",
    "\n",
    "    best = None\n",
    "    for x0 in [(0.1, np.log(ex.mean())), (-0.1, np.log(ex.mean())), (0.5, np.log(ex.mean()))]:\n",
    "        r = minimize(nll, x0, method=\"Nelder-Mead\")\n",
    "        if best is None or r.fun < best.fun:\n",
    "            best = r\n",
    "    return float(best.x[0]), float(np.exp(best.x[1]))\n",
    "\n",
    "\n",
    "def select_censor_quantile(s, q_u=0.80, tol=0.15, grid=None):\n",
    "    \"\"\"Largest censoring quantile whose fitted shape is still on the plateau.\"\"\"\n",
    "    grid = np.arange(0.90, 0.996, 0.005) if grid is None else grid\n",
    "    u = float(np.quantile(s, q_u)); ex = s[s > u] - u\n",
    "    xis = np.array([gpd_censored_fit(ex, float(np.quantile(s, q)) - u)[0] for q in grid])\n",
    "    base = float(np.nanmedian(xis[:3])); qc = float(grid[0])\n",
    "    for q, x in zip(grid, xis):\n",
    "        if not np.isfinite(x) or x > base + tol:\n",
    "            break\n",
    "        qc = float(q)\n",
    "    return qc, grid, xis, base\n",
    "\n",
    "\n",
    "def pot_threshold(s, q_u=0.80, q_c=0.95, expected_fp=0.5, p_target=None):\n",
    "    N = len(s)\n",
    "    p = p_target if p_target is not None else expected_fp / N\n",
    "    u = float(np.quantile(s, q_u)); ex = s[s > u] - u; zeta = 1.0 - q_u\n",
    "    xi, sigma = gpd_censored_fit(ex, float(np.quantile(s, q_c)) - u)\n",
    "    try:\n",
    "        t = (u + (sigma / xi) * ((p / zeta) ** (-xi) - 1.0)) if abs(xi) > 1e-8 \\\n",
    "            else (u - sigma * np.log(p / zeta))\n",
    "    except OverflowError:\n",
    "        t = float(\"inf\")\n",
    "    return float(t), dict(u=u, xi=xi, sigma=sigma, zeta=zeta, q_u=q_u, q_c=q_c, p_target=p)\n",
    "\n",
    "\n",
    "Q_U, EXPECTED_FP = 0.80, 0.5\n",
    "q_c, qc_grid, qc_xis, qc_base = select_censor_quantile(novelty, q_u=Q_U)\n",
    "t_pot, pot_par = pot_threshold(novelty, q_u=Q_U, q_c=q_c, expected_fp=EXPECTED_FP)\n",
    "t_mad = mad_threshold(novelty)\n",
    "t_kde, kde_x, kde_d = kde_valley_threshold(novelty)\n",
    "t_knee, kx, ky, ki = kneedle_threshold(novelty)\n",
    "\n",
    "n_pot = int((novelty > t_pot).sum())\n",
    "if n_pot == 0 or pot_par[\"xi\"] > 0.6:\n",
    "    RULE = \"KDE density valley (POT fallback triggered)\"\n",
    "    THRESHOLD = t_kde if t_kde is not None else t_knee\n",
    "else:\n",
    "    RULE = \"GPD peaks-over-threshold\"\n",
    "    THRESHOLD = t_pot\n",
    "\n",
    "rows = [(\"robust MAD (k=3.5)\", t_mad), (\"KDE valley\", t_kde),\n",
    "        (\"Kneedle elbow\", t_knee), (\"GPD / POT\", t_pot)]\n",
    "summary = pd.DataFrame([(n, v, int((novelty > v).sum())) for n, v in rows\n",
    "                        if v is not None and np.isfinite(v)],\n",
    "                       columns=[\"method\", \"threshold\", \"n_flagged\"])\n",
    "print(summary.round(5).to_string(index=False))\n",
    "print(\"\\nchosen censoring quantile q_c =\", q_c, \"| plateau shape =\", round(qc_base, 3))\n",
    "print(\"GPD fit:\", {k: round(v, 5) for k, v in pot_par.items()})\n",
    "\n",
    "index_df[\"flagged\"] = index_df[\"novelty\"] > THRESHOLD\n",
    "n_flag = int(index_df[\"flagged\"].sum())\n",
    "print(f\"\\nRULE USED: {RULE}\")\n",
    "print(f\"FINAL THRESHOLD = {THRESHOLD:.5f}  ->  {n_flag} crops flagged \"\n",
    "      f\"({100*n_flag/len(index_df):.2f}% of the archive)\")\n",
    "index_df.to_csv(OUT / \"novelty_scores.csv\", index=False)"
