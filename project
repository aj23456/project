    "    fig.suptitle(f\"Figure 3.{rank} \u2014 rank {rank}, {r.file}, novelty {r.novelty:.3f} \"\n",
    "                 f\"({rec['pattern']})\")\n",
    "    fig.tight_layout()\n",
    "    fig.savefig(OUT / f\"figures/fig_3_{rank}_heatmap.png\", dpi=150)\n",
