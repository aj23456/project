    "### 0.1 Dataset, and the crop -> source_image_id mapping used later in Phase 2.3\n",
    "\n",
    "The crops are loaded as single-channel float images in [0, 1]. Augmentation is restricted to\n",
    "flips and 90-degree rotations. Brightness and contrast jitter are deliberately excluded: an\n",
    "injected foreign frame is likely to differ from Martian terrain in exactly those photometric\n",
    "statistics, and augmenting them away would teach the encoder to ignore the signal we want."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "IMG_EXT = (\".jpg\", \".jpeg\", \".png\", \".tif\", \".tiff\", \".bmp\")\n",
    "SRC_RE = re.compile(r\"(ESP|PSP|TRA)_\\d{6}_\\d{4}\", re.IGNORECASE)\n",
    "\n",
    "\n",
    "def list_images(d):\n",
    "    return sorted(p for p in Path(d).rglob(\"*\") if p.suffix.lower() in IMG_EXT)\n",
    "\n",
    "\n",
    "def source_id_from_name(name):\n",
    "    \"\"\"HiRISE observation IDs look like ESP_012345_1234. Returns None if the filename\n",
    "    does not carry one, in which case crop_map.csv is used instead.\"\"\"\n",
    "    m = SRC_RE.search(str(name))\n",
    "    return m.group(0).upper() if m else None\n",
    "\n",
    "\n",
    "def build_index():\n",
    "    paths = list_images(CFG[\"data_dir\"])\n",
    "    if not paths:\n",
    "        raise FileNotFoundError(f\"no images under {CFG['data_dir']}\")\n",
    "    df = pd.DataFrame({\"path\": [str(p) for p in paths],\n",
    "                       \"file\": [p.name for p in paths]})\n",
    "    df[\"source_image_id\"] = df[\"file\"].map(source_id_from_name)\n",
    "\n",
    "    cmap = Path(CFG[\"crop_map_csv\"])\n",
    "    if df[\"source_image_id\"].isna().any() and cmap.exists():\n",
    "        m = pd.read_csv(cmap)[[\"file\", \"source_image_id\"]]\n",
    "        df = df.drop(columns=\"source_image_id\").merge(m, on=\"file\", how=\"left\")\n",
    "\n",
    "    miss = df[\"source_image_id\"].isna().sum()\n",
    "    print(f\"{len(df)} crops | {df['source_image_id'].nunique()} source observations | \"\n",
    "          f\"{miss} crops without a source ID\")\n",
    "    return df\n",
    "\n",
    "\n",
    "class CropDataset(Dataset):\n",
    "    def __init__(self, paths, size=224, augment=False):\n",
    "        self.paths = list(paths); self.size = size; self.augment = augment\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.paths)\n",
    "\n",
    "    def __getitem__(self, i):\n",
    "        img = Image.open(self.paths[i]).convert(\"L\")\n",
    "        if img.size != (self.size, self.size):\n",
    "            img = img.resize((self.size, self.size), Image.BICUBIC)\n",
    "        x = np.asarray(img, dtype=np.float32) / 255.0\n",
    "        if self.augment:\n",
    "            if random.random() < 0.5: x = x[:, ::-1]\n",
    "            if random.random() < 0.5: x = x[::-1, :]\n",
    "            k = random.randint(0, 3)\n",
    "            if k: x = np.rot90(x, k)\n",
    "        return torch.from_numpy(np.ascontiguousarray(x))[None]\n",
    "\n",
    "\n",
    "index_df = build_index()\n",
    "all_paths = index_df[\"path\"].tolist()\n",
    "\n",
    "rng = np.random.default_rng(SEED)\n",
    "perm = rng.permutation(len(all_paths))\n",
    "n_val = int(CFG[\"val_frac\"] * len(all_paths))\n",
    "val_idx, train_idx = perm[:n_val], perm[n_val:]\n",
    "\n",
    "train_ds = CropDataset([all_paths[i] for i in train_idx], CFG[\"img_size\"], augment=True)\n",
    "val_ds   = CropDataset([all_paths[i] for i in val_idx],   CFG[\"img_size\"], augment=False)\n",
    "\n",
    "train_ld = DataLoader(train_ds, batch_size=CFG[\"batch_size\"], shuffle=True,\n",
    "                      num_workers=CFG[\"num_workers\"], pin_memory=True, drop_last=True)\n",
    "val_ld   = DataLoader(val_ds, batch_size=CFG[\"batch_size\"], shuffle=False,\n",
    "                      num_workers=CFG[\"num_workers\"], pin_memory=True)\n",
    "print(\"train:\", len(train_ds), \"val:\", len(val_ds))"
   ]
