    "### 1.3 Training\n",
    "\n",
    "Trained on the full archive, contamination included. The injected outliers are rare, so the\n",
    "network spends almost no capacity on them and reconstructs them worse than ordinary terrain.\n",
    "That asymmetry is what makes the residual informative in Phase 3."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "try:\n",
    "    _GradScaler = lambda: torch.amp.GradScaler(DEV, enabled=(DEV == \"cuda\"))\n",
    "    _autocast = lambda: torch.amp.autocast(device_type=DEV, enabled=(DEV == \"cuda\"))\n",
    "except AttributeError:                                    # older torch\n",
    "    _GradScaler = lambda: torch.cuda.amp.GradScaler(enabled=(DEV == \"cuda\"))\n",
    "    _autocast = lambda: torch.cuda.amp.autocast(enabled=(DEV == \"cuda\"))\n",
    "\n",
    "\n",
    "def run_epoch(model, loader, opt=None, beta=0.0, scaler=None):\n",
    "    train = opt is not None\n",
    "    model.train(train)\n",
    "    tot, n, agg = 0.0, 0, {}\n",
    "    for x in loader:\n",
    "        x = x.to(DEV, non_blocking=True)\n",
    "        with torch.set_grad_enabled(train), _autocast():\n",
    "            xh, mu, logvar = model(x)\n",
    "            loss, parts = composite_loss(x, xh, mu, logvar, beta)\n",
    "        if train:\n",
    "            opt.zero_grad(set_to_none=True)\n",
    "            scaler.scale(loss).backward()\n",
    "            scaler.unscale_(opt)\n",
    "            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "            scaler.step(opt); scaler.update()\n",
    "        b = x.size(0); tot += loss.item() * b; n += b\n",
    "        for k, v in parts.items():\n",
    "            agg[k] = agg.get(k, 0.0) + v * b\n",
    "    return tot / n, {k: v / n for k, v in agg.items()}\n",
    "\n",
    "\n",
    "def train_model(model, epochs=None):\n",
    "    epochs = epochs or CFG[\"epochs\"]\n",
    "    opt = torch.optim.AdamW(model.parameters(), lr=CFG[\"lr\"],\n",
    "                            weight_decay=CFG[\"weight_decay\"])\n",
    "    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs, eta_min=CFG[\"lr\"] * 0.02)\n",
    "    scaler = _GradScaler()\n",
    "    hist, best = [], float(\"inf\")\n",
    "    for ep in range(1, epochs + 1):\n",
    "        beta = CFG[\"beta_kl\"] * min(1.0, ep / 20) if model.variational else 0.0\n",
    "        tr, trp = run_epoch(model, train_ld, opt, beta, scaler)\n",
    "        va, vap = run_epoch(model, val_ld, None, beta)\n",
    "        sched.step()\n",
    "        hist.append({\"epoch\": ep, \"train\": tr, \"val\": va, **{f\"val_{k}\": v for k, v in vap.items()}})\n",
    "        if va < best:\n",
    "            best = va\n",
    "            torch.save(model.state_dict(), OUT / \"ae_best.pt\")\n",
    "        if ep % 5 == 0 or ep == 1:\n",
    "            print(f\"ep {ep:3d} | train {tr:.4f} | val {va:.4f} | \"\n",
    "                  + \" \".join(f\"{k} {v:.4f}\" for k, v in vap.items()))\n",
    "    pd.DataFrame(hist).to_csv(OUT / \"train_history.csv\", index=False)\n",
    "    model.load_state_dict(torch.load(OUT / \"ae_best.pt\", map_location=DEV))\n",
    "    return pd.DataFrame(hist)\n",
    "\n",
    "\n",
    "history = train_model(model)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 3.5))\n",
    "ax.plot(history[\"epoch\"], history[\"train\"], label=\"train\")\n",
    "ax.plot(history[\"epoch\"], history[\"val\"], label=\"val\")\n",
