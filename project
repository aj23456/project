    "### 3.1 Pixel-wise error heatmaps (15 pts)\n",
    "\n",
    "The highest-scoring crops **from the thresholded set** are passed back through the decoder.\n",
    "Taking five is a presentation step applied after thresholding; if fewer than five crops sit\n",
    "above the threshold, only those are analysed and the threshold is not relaxed.\n",
    "\n",
    "Each error map is summarised by five scalars, computed on the unsmoothed squared error\n",
    "(smoothing is applied only for display, since a Gaussian blur manufactures spatial\n",
    "autocorrelation and would corrupt Moran's I):\n",
    "\n",
    "- concentration ratio, the share of total error in the top 1 percent of pixels divided by the\n",
    "  0.01 a uniform map would give, so 1 means uniform and 10 means ten times as peaked;\n",
    "- the Gini coefficient of the error;\n",
    "- Moran's I, high when the error forms coherent regions rather than salt-and-pepper noise;\n",
    "- structure-tensor coherence, high when the error is aligned along one direction, as a splice\n",
    "  seam or a linear ridge would be;\n",
    "- the share of error inside the outer 10 percent border.\n",
    "\n",
    "Absolute cutoffs on these numbers would be arbitrary, so each descriptor is converted to a\n",
    "percentile against a reference sample of ordinary crops drawn from below the threshold. The\n",
    "pattern label is then a statement about how unusual the error geometry is relative to normal\n",
    "reconstruction residue, which is what the physical reasoning in 3.2 actually needs."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "from scipy.ndimage import gaussian_filter\n",
    "\n",
    "N_BASELINE = 150          # ordinary crops used as the reference population\n",
    "\n",
    "\n",
    "def gini(v):\n",
    "    v = np.sort(v.ravel()); n = v.size\n",
    "    c = np.cumsum(v)\n",
    "    return float((n + 1 - 2 * (c / c[-1]).sum()) / n)\n",
    "\n",
    "\n",
    "def morans_I(E):\n",
    "    z = E - E.mean()\n",
    "    num = (z[:, :-1] * z[:, 1:]).sum() + (z[:-1, :] * z[1:, :]).sum()\n",
    "    W = z[:, :-1].size + z[:-1, :].size\n",
    "    den = (z ** 2).sum() + 1e-12\n",
    "    return float(z.size * num / (W * den))\n",
    "\n",
    "\n",
    "def coherence(E, sigma=3.0):\n",
    "    gy, gx = np.gradient(E)\n",
    "    Jxx = gaussian_filter(gx * gx, sigma)\n",
    "    Jyy = gaussian_filter(gy * gy, sigma)\n",
    "    Jxy = gaussian_filter(gx * gy, sigma)\n",
    "    tr = Jxx + Jyy + 1e-12\n",
    "    coh = np.sqrt((Jxx - Jyy) ** 2 + 4 * Jxy ** 2) / tr\n",
    "    return float((coh * tr).sum() / tr.sum())          # energy-weighted mean\n",
    "\n",
    "\n",
    "def descriptors(E):\n",
    "    \"\"\"E is the raw, unsmoothed squared-error map.\"\"\"\n",
    "    e = E.ravel(); k = max(1, int(0.01 * e.size))\n",
    "    top1 = float(np.sort(e)[-k:].sum() / (e.sum() + 1e-12))\n",
    "    h, w = E.shape; b = int(0.10 * h)\n",
    "    border = E.copy(); border[b:h - b, b:w - b] = 0\n",
    "    return {\"conc_ratio\": top1 / 0.01, \"gini\": gini(e), \"morans_I\": morans_I(E),\n",
    "            \"coherence\": coherence(E), \"border_frac\": float(border.sum() / (E.sum() + 1e-12))}\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def reconstruct(path):\n",
    "    x = CropDataset([path], CFG[\"img_size\"])[0][None].to(DEV)\n",
    "    mu, _ = model.encode(x)\n",
    "    xh = model.dec(mu)\n",
    "    return x[0, 0].cpu().numpy(), xh[0, 0].cpu().numpy()\n",
    "\n",
    "\n",
    "def error_map(path):\n",
    "    x, xh = reconstruct(path)\n",
    "    return x, xh, (x - xh) ** 2\n",
    "\n",
    "\n",
    "# reference population of ordinary crops\n",
    "base_paths = (df.loc[~df[\"flagged\"], \"path\"]\n",
    "                .sample(min(N_BASELINE, int((~df[\"flagged\"]).sum())), random_state=SEED))\n",
    "base_desc = pd.DataFrame([descriptors(error_map(p)[2]) for p in base_paths])\n",
    "print(\"reference descriptors over\", len(base_desc), \"ordinary crops:\")\n",
    "print(base_desc.describe().loc[[\"mean\", \"50%\", \"max\"]].round(3).to_string())\n",
    "\n",
    "\n",
    "def pctile(name, v):\n",
    "    return float((base_desc[name] < v).mean() * 100)\n",
    "\n",
    "\n",
    "def pattern_label(pc):\n",
    "    if pc[\"border_frac\"] >= 95:\n",
    "        return \"error hugs the frame edge\"\n",
    "    if pc[\"coherence\"] >= 90 and pc[\"conc_ratio\"] >= 75:\n",
    "        return \"error concentrated along a linear feature\"\n",
    "    if pc[\"conc_ratio\"] >= 90:\n",
    "        return \"error concentrated in a compact region\"\n",
    "    if pc[\"morans_I\"] <= 25:\n",
    "        return \"error fine-grained and spread over the frame\"\n",
    "    return \"error diffuse across the frame\"\n",
    "\n",
    "\n",
    "top = df[df[\"flagged\"]].sort_values(\"novelty\", ascending=False)\n",
    "sel = top.head(5)\n",
    "if len(top) < 5:\n",
    "    print(f\"\\nonly {len(top)} crops exceed the threshold; analysing all of them \"\n",
    "          f\"rather than lowering the threshold\")\n",
    "\n",
    "records = []\n",
    "for rank, r in enumerate(sel.itertuples(), 1):\n",
    "    x, xh, E = error_map(r.path)\n",
    "    d = descriptors(E)\n",
    "    pc = {k: pctile(k, v) for k, v in d.items()}\n",
    "    rec = {\"rank\": rank, \"file\": r.file, \"source_image_id\": r.source_image_id,\n",
    "           \"novelty\": r.novelty, **{k: round(v, 3) for k, v in d.items()},\n",
    "           **{f\"pct_{k}\": round(v, 1) for k, v in pc.items()},\n",
    "           \"pattern\": pattern_label(pc)}\n",
    "    records.append(rec)\n",
    "\n",
    "    Ed = gaussian_filter(E, 2.0)                      # smoothed for display only\n",
    "    fig, ax = plt.subplots(1, 3, figsize=(12, 4.2))\n",
    "    ax[0].imshow(x, cmap=\"gray\"); ax[0].set_title(\"original\")\n",
    "    ax[1].imshow(xh, cmap=\"gray\"); ax[1].set_title(\"reconstruction\")\n",
    "    ax[2].imshow(x, cmap=\"gray\")\n",
    "    im = ax[2].imshow(Ed, cmap=\"inferno\", alpha=0.55)\n",
