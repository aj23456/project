    "def gn(c):\n",
    "    return nn.GroupNorm(min(8, c), c)\n",
    "\n",
    "\n",
    "class Down(nn.Module):\n",
    "    def __init__(self, ci, co):\n",
    "        super().__init__()\n",
    "        self.body = nn.Sequential(\n",
    "            nn.Conv2d(ci, co, 4, 2, 1), gn(co), nn.SiLU(inplace=True),\n",
    "            nn.Conv2d(co, co, 3, 1, 1), gn(co), nn.SiLU(inplace=True))\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.body(x)\n",
    "\n",
    "\n",
    "class Up(nn.Module):\n",
    "    \"\"\"Resize-convolution: avoids the checkerboard artefacts of ConvTranspose2d.\"\"\"\n",
    "    def __init__(self, ci, co):\n",
    "        super().__init__()\n",
    "        self.body = nn.Sequential(\n",
    "            nn.Upsample(scale_factor=2, mode=\"nearest\"),\n",
    "            nn.Conv2d(ci, co, 3, 1, 1), gn(co), nn.SiLU(inplace=True),\n",
    "            nn.Conv2d(co, co, 3, 1, 1), gn(co), nn.SiLU(inplace=True))\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.body(x)\n",
    "\n",
    "\n",
    "class Encoder(nn.Module):\n",
    "    def __init__(self, latent=256, variational=False, chs=(32, 64, 128, 256, 256)):\n",
    "        super().__init__()\n",
    "        self.variational = variational\n",
    "        layers, ci = [], 1\n",
    "        for co in chs:\n",
    "            layers.append(Down(ci, co)); ci = co\n",
    "        self.conv = nn.Sequential(*layers)\n",
    "        self.flat_dim = chs[-1] * 7 * 7\n",
    "        self.fc = nn.Linear(self.flat_dim, latent * (2 if variational else 1))\n",
    "        self.latent = latent\n",
    "\n",
    "    def forward(self, x):\n",
    "        h = self.conv(x).flatten(1)\n",
    "        h = self.fc(h)\n",
    "        if self.variational:\n",
    "            mu, logvar = h.chunk(2, dim=1)\n",
    "            return mu, logvar\n",
    "        return h, None\n",
    "\n",
    "\n",
    "class Decoder(nn.Module):\n",
    "    def __init__(self, latent=256, chs=(256, 256, 128, 64, 32, 32)):\n",
    "        super().__init__()\n",
    "        self.c0 = chs[0]\n",
    "        self.fc = nn.Linear(latent, chs[0] * 7 * 7)\n",
    "        ups = [Up(chs[i], chs[i + 1]) for i in range(len(chs) - 1)]\n",
    "        self.up = nn.Sequential(*ups)\n",
    "        self.out = nn.Conv2d(chs[-1], 1, 3, 1, 1)\n",
    "\n",
    "    def forward(self, z):\n",
    "        h = self.fc(z).view(-1, self.c0, 7, 7)\n",
    "        h = self.up(h)\n",
    "        return torch.sigmoid(self.out(h))\n",
    "\n",
    "\n",
    "class AutoEncoder(nn.Module):\n",
    "    def __init__(self, latent=256, variational=False):\n",
    "        super().__init__()\n",
    "        self.variational = variational\n",
    "        self.enc = Encoder(latent, variational)\n",
    "        self.dec = Decoder(latent)\n",
    "\n",
    "    def encode(self, x):\n",
    "        mu, logvar = self.enc(x)\n",
    "        return mu, logvar\n",
    "\n",
    "    def forward(self, x):\n",
    "        mu, logvar = self.enc(x)\n",
    "        if self.variational and self.training:\n",
    "            z = mu + torch.randn_like(mu) * torch.exp(0.5 * logvar)\n",
    "        else:\n",
    "            z = mu\n",
    "        return self.dec(z), mu, logvar\n",
    "\n",
    "\n",
    "model = AutoEncoder(CFG[\"latent_dim\"], variational=(CFG[\"model\"] == \"vae\")).to(DEV)\n",
    "n_par = sum(p.numel() for p in model.parameters())\n",
    "print(f\"parameters: {n_par/1e6:.2f} M\")\n",
    "\n",
    "# shape smoke test (runs without the dataset present)\n",
    "with torch.no_grad():\n",
    "    xh, mu, _ = model(torch.zeros(2, 1, CFG[\"img_size\"], CFG[\"img_size\"], device=DEV))\n",
    "print(\"recon:\", tuple(xh.shape), \"| latent:\", tuple(mu.shape))"
   ]
