    "def encode_metadata(d):\n",
    "    cols = []\n",
    "    if \"sun_angle\" in d:\n",
    "        a = np.deg2rad(d[\"sun_angle\"].fillna(d[\"sun_angle\"].median()).values)\n",
    "        cols += [np.sin(a), np.cos(a)]\n",
    "    if \"resolution\" in d:\n",
    "        r = np.log1p(d[\"resolution\"].fillna(d[\"resolution\"].median()).values)\n",
    "        cols.append((r - r.mean()) / (r.std() + 1e-9))\n",
    "    M = np.stack(cols, 1) if cols else np.zeros((len(d), 0))\n",
    "    if \"season\" in d:\n",
    "        M = np.hstack([M, pd.get_dummies(d[\"season\"].fillna(\"unk\")).values.astype(float)])\n",
    "    return M\n",
    "\n",
    "\n",
    "M = encode_metadata(df)\n",
    "alpha = np.sqrt(0.10 * (X.var(0).sum()) / max(M.var(0).sum(), 1e-9))\n",
    "Xf = np.hstack([X, alpha * M])\n",
